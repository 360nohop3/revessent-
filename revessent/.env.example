# Real-mode server env (packages/config validates; boot fails loudly if missing).
# NEVER put real secrets in the repo — this file is the template only.
DATABASE_URL=postgres://revessent_app:CHANGE_ME@localhost:5433/revessent
APP_DATABASE_URL=postgres://revessent_app:CHANGE_ME@localhost:5433/revessent
MIGRATE_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5433/revessent
BETTER_AUTH_SECRET=generate_with_openssl_rand_base64_48
KEY_ENCRYPTION_KEY=generate_32_byte_base64_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000

# Demo mode is an explicit opt-in for development/demo builds only.
# In production this flag MUST stay unset (packages/config refuses prod+demo).
NEXT_PUBLIC_DEMO_MODE=on

# argon2id password hashing (doc defaults; tests may lower m for speed)
ARGON2_MEMORY_KIB=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=4
