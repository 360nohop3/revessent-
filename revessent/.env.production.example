# REVESSENT — PRODUCTION environment template (Phase 8 §20).
# Template only. NEVER commit real values. Every variable below is server-only;
# the ONLY browser-visible variable in the codebase is NEXT_PUBLIC_DEMO_MODE,
# which MUST stay unset in production (boot refuses it).

# ---- web (Next.js) + worker: core (packages/config ServerEnvSchema) ----
NODE_ENV=production
DATABASE_URL=postgres://revessent_app:***@host:5432/revessent          # RLS-bound app role
APP_DATABASE_URL=postgres://revessent_app:***@host:5432/revessent      # optional; defaults to DATABASE_URL
BETTER_AUTH_SECRET=***                                                  # >= 32 chars; openssl rand -base64 48
KEY_ENCRYPTION_KEY=***                                                  # 32-byte base64; openssl rand -base64 32 (Stripe key + webhook secret envelope)
BETTER_AUTH_URL=https://app.example.com                                 # https REQUIRED in prod; auth base + tenant webhook endpoint origin
APP_PUBLIC_URL=https://app.example.com                                  # https REQUIRED in prod; customer + account email links
LOG_LEVEL=info                                                          # debug|info|warn|error (redacting logger)

# ---- account + customer email (Postmark; Phase 6 provider, reused for verify/reset) ----
POSTMARK_SERVER_TOKEN=***                                               # REQUIRED in prod: sign-up verification + password reset fail closed without it
POSTMARK_MESSAGE_STREAM=outbound
EMAIL_FROM_ADDRESS=billing@notifications.example.com                    # verified sender signature/domain in Postmark

# ---- AI (optional; absent => deterministic templates) ----
ANTHROPIC_API_KEY=***
AI_MODEL=claude-3-5-haiku-latest
AI_TIMEOUT_MS=12000

# ---- Revessent's OWN billing webhook (Stripe Billing, platform account) ----
BILLING_WEBHOOK_SECRET=whsec_***                                        # from the platform endpoint pointing at /api/v1/webhooks/billing
BILLING_LIVEMODE=true                                                   # prod endpoint accepts live events only

# ---- worker only (packages/config WorkerEnvSchema) ----
REDIS_URL=rediss://:***@host:6379                                       # BullMQ; credential, never logged
SCHEDULER_DATABASE_URL=postgres://revessent_owner:***@host:5432/revessent   # org enumeration + org-row reads ONLY
WORKER_HEALTH_PORT=8081                                                 # /healthz readiness
WORKER_RETRIES_CONCURRENCY=5
WORKER_NOTES_CONCURRENCY=5
WORKER_POLL_MS=15000
WORKER_LEASE_SECONDS=300

# ---- migrations (CI/CD step only; owner role) ----
MIGRATE_DATABASE_URL=postgres://revessent_owner:***@host:5432/revessent
